{
    "text": {
        "0_Section, 0_Paragraph": "לְכָה דוֹדִי לִקְרַאת כַּלָּה",
        "0_Section, 1_Paragraph": "פְּנֵי שַׁבָּת נְקַבְּלָה",
        "1_Section, 0_Paragraph": "שָׁמוֹר וְזָכוֹר בְּדִבּוּר אֶחָד",
        "1_Section, 1_Paragraph": "הִשְׁמִיעָנוּ אֵל הַמְּיֻחָד",
        "1_Section, 2_Paragraph": "ה' אֶחָד וּשְׁמוֹ אֶחָד",
        "1_Section, 3_Paragraph": "לְשֵׁם וּלְתִפְאֶרֶת וְלִתְהִלָּה",
        "2_Section, 0_Paragraph": "לִקְרַאת שַׁבָּת לְכוּ וְנֵלְכָה",
        "2_Section, 1_Paragraph": "כִּי הִיא מְקוֹר הַבְּרָכָה",
        "2_Section, 2_Paragraph": "מֵרֹאשׁ מִקֶּדֶם נְסוּכָה",
        "2_Section, 3_Paragraph": "סוֹף מַעֲשֶּׂה בְּמַחֲשָׁבָה תְּחִלָּה",
        "3_Section, 0_Paragraph": "מִקְדַּשׁ מֶלֶךְ עִיר מְלוּכָה",
        "3_Section, 1_Paragraph": "קוּמִי צְאִי מִתּוֹךְ הַהֲפֵכָה",
        "3_Section, 2_Paragraph": "רַב לָךְ שֶׁבֶת בְּעֵמֶק הַבָּכָא",
        "3_Section, 3_Paragraph": "וְהוּא יַחֲמוֹל עָלַיִךְ חֶמְלָּה",
        "4_Section, 0_Paragraph": "הִתְנַעֲרִי מֵעָפָר קוּמִי",
        "4_Section, 1_Paragraph": "לִבְשִׁי בִּגְדֵי תִּפְאַרְתֵּךְ עַמִּי",
        "4_Section, 2_Paragraph": "עַל יַד בֶּן יִשַׁי בֵּית הַלַּחְמִי",
        "4_Section, 3_Paragraph": "קָרְבָה אֶל נַפְשִׁי גְאָלָהּ",
        "5_Section, 0_Paragraph": "הִתְעוֹרְרִי הִתְעוֹרְרִי",
        "5_Section, 1_Paragraph": "כִּי בָא אורֵךְ קוּמִי אוֹרִי",
        "5_Section, 2_Paragraph": "עוּרִי עוּרִי שִׁיר דַּבֵּרִי",
        "5_Section, 3_Paragraph": "כְּבוֹד ה' עָלַיִךְ נִגְלָּה",
        "6_Section, 0_Paragraph": "לֹא תֵּבֹשִׁי וְלֹא תִּכָּלְמִי",
        "6_Section, 1_Paragraph": "מַה תִּשְׁתּוֹחֲחִי וּמַה תֶּהֱמִי",
        "6_Section, 2_Paragraph": "בָּךְ יֶחֱסוּ עֲנִיֵּי עַמִּי",
        "6_Section, 3_Paragraph": "וְנִבְנְתָה עִיר עַל תִּלָּהּ",
        "7_Section, 0_Paragraph": "וְהָיוּ לִמְשִׁסָּה שֹׁאסָיִךְ",
        "7_Section, 1_Paragraph": "וְרָחֲקוּ כָּל מְבַלְּעָיִךְ",
        "7_Section, 2_Paragraph": "יָשִּׂישּׂ עָלַיִךְ אֱלֹהָיִךְ",
        "7_Section, 3_Paragraph": "כִּמְשּׂוֹשּׂ חָתָן עַל כַּלָּה",
        "8_Section, 0_Paragraph": "יָמִין וּשְּׂמֹאל תִּפְרֹצִי",
        "8_Section, 1_Paragraph": "וְאֶת ה' תַּעֲרִיצִי",
        "8_Section, 2_Paragraph": "עַל יַד אִישׁ בֶּן פַּרְצִי",
        "8_Section, 3_Paragraph": "וְנִשְּׂמְחָה וְנָגִילָה",
        "9_Section, 0_Paragraph": "בֹּאִי בְשָׁלוֹם עֲטֶרֶת בַּעְלָהּ",
        "9_Section, 1_Paragraph": "גַּם בְּשִּׂמְחָה וּבְצָהֳלָה",
        "9_Section, 2_Paragraph": "תּוֹךְ אֱמוּנֵי עַם סְגֻלָּה",
        "9_Section, 3_Paragraph": "בּוֹאִי כַלָּה בּוֹאִי כַלָּה"
    },
    "meta": "Section-Paragraph",
    "work": "Lekha Dodi"
}