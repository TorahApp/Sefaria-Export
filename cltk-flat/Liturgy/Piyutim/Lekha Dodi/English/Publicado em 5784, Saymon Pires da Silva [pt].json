{
    "text": {
        "0_Section, 0_Paragraph": "Lechah Dodi Likrat Kallah  ",
        "0_Section, 1_Paragraph": "Pnei Shabbat NeKabelah",
        "1_Section, 0_Paragraph": "Shamor Vezachor Bedibur Echad  ",
        "1_Section, 1_Paragraph": "Hishmi'anu El HaMeyuchad  ",
        "1_Section, 2_Paragraph": "Adonai Echad Ushemo Echad  ",
        "1_Section, 3_Paragraph": "Leshem UlTiferet ULTehillah",
        "3_Section, 0_Paragraph": "Mikdash Melech Ir Meluchah  ",
        "3_Section, 1_Paragraph": "Kumi Tzei Mitoch Hahafêchah  ",
        "3_Section, 2_Paragraph": "Rav Lach Shevet Beêmek Habakha  ",
        "3_Section, 3_Paragraph": "Vehu Yachamol Alayich Chemlah",
        "4_Section, 0_Paragraph": "Hitnaari meafar kumi  ",
        "4_Section, 1_Paragraph": "Livshi bigdei tifarteich ami  ",
        "4_Section, 2_Paragraph": "Al yad ben Yishai beit halachmi  ",
        "4_Section, 3_Paragraph": "K'rava el nafshi gealah",
        "5_Section, 0_Paragraph": "Hit'orêri hit'orêri  ",
        "5_Section, 1_Paragraph": "Ki va orech, kumi ori  ",
        "5_Section, 2_Paragraph": "Uri uri, shir dabêri  ",
        "5_Section, 3_Paragraph": "Khevôd Adonai alayich nigláh",
        "6_Section, 0_Paragraph": "Lo tevoshi velo ticcami",
        "6_Section, 1_Paragraph": "Mah tistochchi umah tehemmi",
        "6_Section, 2_Paragraph": "Bach yechesu aniyei ammi",
        "6_Section, 3_Paragraph": "Venivneita ir al tillah",
        "7_Section, 0_Paragraph": "Vehayu limshisah shosayich  ",
        "7_Section, 1_Paragraph": "Verachaku chol mevaleyayich  ",
        "7_Section, 2_Paragraph": "Yasis alayich Elohayich  ",
        "7_Section, 3_Paragraph": "Kimsose chatan al kallah",
        "8_Section, 0_Paragraph": "Yamim Usmol Tifrotsi  ",
        "8_Section, 1_Paragraph": "Ve'et Adonai Ta'aritsi  ",
        "8_Section, 2_Paragraph": "Al Yad Ish Ben Partsi  ",
        "8_Section, 3_Paragraph": "Venismecha Venagilah",
        "9_Section, 0_Paragraph": "Boí veshalóm atérét baaláh  ",
        "9_Section, 1_Paragraph": "Gam besimcháh uvetzaholah  ",
        "9_Section, 2_Paragraph": "Tóch emunéi am seguláh  ",
        "9_Section, 3_Paragraph": "Boí kalláh boí kalláh"
    },
    "meta": "Section-Paragraph",
    "work": "Lekha Dodi"
}